<?xml version="1.0" encoding="utf-8"?>
<!-- 튠즈: machined steel dial with an engraved play mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer chrome ring -->
    <path android:pathData="M54,24a30,30 0,1 1,0 60a30,30 0,1 1,0 -60z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="26"
                android:endX="78" android:endY="82"
                android:startColor="#FFF2F5F8"
                android:centerColor="#FF7D8894"
                android:endColor="#FFC4CDD6" />
        </aapt:attr>
    </path>
    <!-- gunmetal face -->
    <path android:pathData="M54,29a25,25 0,1 1,0 50a25,25 0,1 1,0 -50z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="30"
                android:endX="74" android:endY="78"
                android:startColor="#FF3A424B"
                android:endColor="#FF0F1215" />
        </aapt:attr>
    </path>
    <!-- lathe grooves -->
    <path
        android:pathData="M54,33a21,21 0,1 1,0 42a21,21 0,1 1,0 -42z"
        android:strokeWidth="0.6"
        android:strokeColor="#33FFFFFF"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,37a17,17 0,1 1,0 34a17,17 0,1 1,0 -34z"
        android:strokeWidth="0.6"
        android:strokeColor="#26FFFFFF"
        android:fillColor="#00000000" />
    <!-- dial tick -->
    <path
        android:pathData="M53,30.5h2v5h-2z"
        android:fillColor="#FF7FD3E8" />
    <!-- engraved play mark -->
    <path
        android:pathData="M49,44.5L63.5,54L49,63.5Z"
        android:fillColor="#FFDCE5EE" />
</vector>
